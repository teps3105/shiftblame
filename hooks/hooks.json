{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 載入精簡治理提示"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 更新回合觀測與訪談提示"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 核對訪談、路徑與提交邊界"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 成功時歸零失敗計數"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 累計連續失敗並注入引導"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 注入載入程序與不變量"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 不變量卡＋節點行與停點申報行"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 回合結束（路由與流程接續由主對話承擔）"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 節點矩陣、commit 印章與路徑防護"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "timeout": 10,
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "statusMessage": "shiftblame: Jev 前置初判與例外分流"
          }
        ]
      }
    ]
  }
}

{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 載入精簡治理提示"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 更新回合觀測與目前階段"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 核對狀態、路徑與提交邊界"
          }
        ]
      }
    ]
  }
}

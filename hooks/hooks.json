{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 注入載入程序與不變量"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 不變量卡"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/shiftblame-guard.mjs\"",
            "timeout": 10,
            "statusMessage": "shiftblame: 節點矩陣、commit 印章與路徑防護"
          }
        ]
      }
    ]
  }
}

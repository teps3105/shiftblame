{
  "scripts": {
    "skillTriggerCheck": "bash ~/.codex/skills/shiftblame/scripts/skill-trigger-check.sh",
    "taskDispatchCheck": "bash ~/.codex/skills/shiftblame/scripts/task-dispatch-check.sh",
    "gatePrereqCheck": "bash ~/.codex/skills/shiftblame/scripts/gate-prereq-check.sh",
    "subagentOutputCheck": "bash ~/.codex/skills/shiftblame/scripts/subagent-output-check.sh",
    "taskInit": "bash ~/.codex/skills/shiftblame/scripts/task-init.sh",
    "slugArchive": "bash ~/.codex/skills/shiftblame/scripts/slug-archive.sh"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "command": "bash ~/.codex/skills/shiftblame/scripts/skill-trigger-check.sh"
      },
      {
        "matcher": "spawn_agent",
        "command": "bash ~/.codex/skills/shiftblame/scripts/task-dispatch-check.sh"
      },
      {
        "matcher": "request_user_input",
        "command": "bash ~/.codex/skills/shiftblame/scripts/gate-prereq-check.sh"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "spawn_agent",
        "command": "bash ~/.codex/skills/shiftblame/scripts/subagent-output-check.sh"
      }
    ]
  }
}
